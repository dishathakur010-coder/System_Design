<mxfile host="app.diagrams.net" agent="Codex" compressed="false" pages="2">
  <diagram id="simple-url-shortener" name="Simple URL Shortener System Design">
    <mxGraphModel dx="2943" dy="1506" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=30;fontStyle=1;fontColor=#172B4D;align=left;" value="Simple URL Shortener —System Design" vertex="1">
          <mxGeometry height="45" width="2100" x="60" y="25" as="geometry" />
        </mxCell>
        <mxCell id="functional" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;strokeWidth=2;fontColor=#172B4D;fontSize=14;spacing=16;align=left;verticalAlign=top;" value="&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;/b&gt;FUNCTIONAL REQUIREMENTS&lt;br&gt;&lt;br&gt;1. Accept and validate an HTTP/HTTPS long URL.&lt;br&gt;2. Generate a unique, opaque 8-character code.&lt;br&gt;3. Persist code → long URL before returning success.&lt;br&gt;4. Return the complete short URL to the client.&lt;br&gt;5. Redirect a known code using HTTP 302.&lt;br&gt;6. Return 404 for an unknown code.&lt;br&gt;7. Make creation retries safe using Idempotency-Key." vertex="1">
          <mxGeometry height="305" width="500" x="60" y="125" as="geometry" />
        </mxCell>
        <mxCell id="nonfunctional" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#172B4D;fontSize=14;spacing=16;align=left;verticalAlign=top;" value="&lt;b&gt;NON-FUNCTIONAL REQUIREMENTS&lt;/b&gt;&#xa;&#xa;• Redirect p99 &lt; 100 ms on a regional cache hit.&#xa;• Creation p99 &lt; 300 ms.&#xa;• 99.99% redirect availability target.&#xa;• No acknowledged mapping is lost.&#xa;• Immediate read-after-write after creation.&#xa;• Horizontally scalable stateless services.&#xa;• TLS, rate limiting and abuse protection.&#xa;• Metrics, tracing, backups and tested failover." vertex="1">
          <mxGeometry height="305" width="540" x="590" y="125" as="geometry" />
        </mxCell>
        <mxCell id="estimate-box" parent="1" style="swimlane=1;horizontal=1;startSize=38;rounded=1;html=1;fillColor=#FAFBFC;swimlaneFillColor=#172B4D;strokeColor=#172B4D;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" value="BACK-OF-THE-ENVELOPE ESTIMATION" vertex="1">
          <mxGeometry height="305" width="1180" x="1160" y="125" as="geometry" />
        </mxCell>
        <mxCell id="traffic-est" parent="estimate-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontColor=#172B4D;fontSize=13;spacing=12;align=left;verticalAlign=top;" value="&lt;b&gt;TRAFFIC&lt;/b&gt;&#xa;&#xa;100M new URLs/month&#xa;100 redirects per creation&#xa;10× peak factor&#xa;&#xa;&lt;b&gt;Average:&lt;/b&gt; 39 writes/s, 3.9K reads/s&#xa;&lt;b&gt;Peak:&lt;/b&gt; 390 writes/s, 38.6K reads/s" vertex="1">
          <mxGeometry height="215" width="270" x="20" y="60" as="geometry" />
        </mxCell>
        <mxCell id="storage-est" parent="estimate-box" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#172B4D;fontSize=13;spacingTop=16;" value="&lt;b&gt;STORAGE&lt;/b&gt;&#xa;&#xa;5 years = 6B mappings&#xa;~500 B per mapping&#xa;&lt;b&gt;3 TB raw&lt;/b&gt;&#xa;&lt;b&gt;9 TB with 3 copies&lt;/b&gt;&#xa;Plan ~12 TB with 30% headroom" vertex="1">
          <mxGeometry height="225" width="260" x="315" y="55" as="geometry" />
        </mxCell>
        <mxCell id="cache-est" parent="estimate-box" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFF4E5;strokeColor=#FFAB00;fontColor=#172B4D;fontSize=13;spacingTop=16;" value="&lt;b&gt;CACHE&lt;/b&gt;&#xa;&#xa;100M hot mappings&#xa;≈ 50 GB raw&#xa;≈ 80–100 GB with overhead&#xa;Replicate across Redis nodes&#xa;Target cache hit rate ≥ 95%" vertex="1">
          <mxGeometry height="225" width="260" x="600" y="55" as="geometry" />
        </mxCell>
        <mxCell id="server-est" parent="estimate-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontColor=#172B4D;fontSize=13;spacing=12;align=left;verticalAlign=top;" value="&lt;b&gt;SERVER ESTIMATE&lt;/b&gt;&#xa;&#xa;Redirect node capacity assumption: 5K RPS&#xa;38.6K / 5K ≈ 8 nodes&#xa;Deploy 10 per region for failover headroom&#xa;&#xa;Create path: 3 nodes per region&#xa;DB: 8 logical shards × 3 copies" vertex="1">
          <mxGeometry height="215" width="275" x="885" y="60" as="geometry" />
        </mxCell>
        <mxCell id="api-box" parent="1" style="swimlane=1;horizontal=1;startSize=38;rounded=1;html=1;fillColor=#FAFBFC;swimlaneFillColor=#4C9AFF;strokeColor=#4C9AFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" value="API METHODS AND ENDPOINTS" vertex="1">
          <mxGeometry height="335" width="1070" x="60" y="465" as="geometry" />
        </mxCell>
        <mxCell id="post-api" parent="api-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontColor=#172B4D;fontSize=13;fontFamily=Consolas;spacing=14;align=left;verticalAlign=top;" value="&lt;b&gt;POST /v1/urls&lt;/b&gt;&#xa;&#xa;Header: Idempotency-Key: optional&#xa;Body: { &amp;quot;longUrl&amp;quot;: &amp;quot;https://example.com/path&amp;quot; }&#xa;&#xa;&lt;b&gt;201 Created&lt;/b&gt;&#xa;{ &amp;quot;code&amp;quot;: &amp;quot;g7K2pQ9x&amp;quot;,&#xa;  &amp;quot;shortUrl&amp;quot;: &amp;quot;https://sho.rt/g7K2pQ9x&amp;quot; }&#xa;&#xa;400 invalid · 413 too long · 429 limited · 503 unavailable" vertex="1">
          <mxGeometry height="250" width="550" x="20" y="58" as="geometry" />
        </mxCell>
        <mxCell id="get-api" parent="api-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#172B4D;fontSize=13;fontFamily=Consolas;spacing=14;align=left;verticalAlign=top;" value="&lt;b&gt;GET /{code}&lt;/b&gt;&#xa;&#xa;&lt;b&gt;302 Found&lt;/b&gt;&#xa;Location: https://example.com/path&#xa;Cache-Control: public, max-age=300&#xa;&#xa;404 Not Found — unknown code&#xa;410 Gone — disabled/expired link&#xa;&#xa;&lt;b&gt;HEAD /{code}&lt;/b&gt;&#xa;Optional lightweight existence/redirect check." vertex="1">
          <mxGeometry height="250" width="445" x="600" y="58" as="geometry" />
        </mxCell>
        <mxCell id="db-box" parent="1" style="swimlane=1;horizontal=1;startSize=38;rounded=1;html=1;fillColor=#FAFBFC;swimlaneFillColor=#36B37E;strokeColor=#36B37E;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" value="DATABASE STRUCTURE" vertex="1">
          <mxGeometry height="335" width="1180" x="1160" y="465" as="geometry" />
        </mxCell>
        <mxCell id="mapping-table" parent="db-box" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#172B4D;fontSize=13;fontFamily=Consolas;spacingTop=20;spacingLeft=12;align=left;" value="&lt;b&gt;URL_MAPPING&lt;/b&gt;&#xa;────────────────────────────&#xa;code         CHAR(8)      PRIMARY KEY&#xa;long_url     TEXT         NOT NULL&#xa;created_at   TIMESTAMP    NOT NULL&#xa;status       SMALLINT     DEFAULT 1&#xa;url_hash     BINARY       optional&#xa;&#xa;Shard key: hash(code)&#xa;Invariant: one code → one long URL" vertex="1">
          <mxGeometry height="255" width="460" x="25" y="55" as="geometry" />
        </mxCell>
        <mxCell id="idempotency-table" parent="db-box" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontColor=#172B4D;fontSize=13;fontFamily=Consolas;spacingTop=18;spacingLeft=12;align=left;" value="&lt;b&gt;IDEMPOTENCY_RECORD&lt;/b&gt;&#xa;────────────────────────&#xa;idempotency_key  VARCHAR  PK&#xa;code             CHAR(8)&#xa;request_hash     BINARY&#xa;created_at       TIMESTAMP&#xa;expires_at       TIMESTAMP&#xa;&#xa;Prevents duplicate links on client retry." vertex="1">
          <mxGeometry height="235" width="330" x="515" y="65" as="geometry" />
        </mxCell>
        <mxCell id="key-pool-table" parent="db-box" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontColor=#172B4D;fontSize=13;spacingTop=18;" value="&lt;b&gt;KEY POOL&lt;/b&gt;&#xa;&#xa;8-char Base62 codes&#xa;unused → leased → used&#xa;atomic batch leases&#xa;UNIQUE(code) guard&#xa;&#xa;62⁸ ≈ 218 trillion keys" vertex="1">
          <mxGeometry height="235" width="280" x="875" y="65" as="geometry" />
        </mxCell>
        <mxCell id="db-rel1" edge="1" parent="db-box" source="idempotency-table" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#4C9AFF;fontSize=11;" target="mapping-table" value="returns code">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="db-rel2" edge="1" parent="db-box" source="key-pool-table" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#6554C0;fontSize=11;" target="mapping-table" value="leased code">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
