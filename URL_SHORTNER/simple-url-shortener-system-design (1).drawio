        </mxCell>
        <mxCell id="kgs" parent="arch-box" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#EAE6FF;strokeColor=#6554C0;strokeWidth=2;fontColor=#172B4D;fontSize=12;" value="&lt;b&gt;KEY GENERATOR&lt;/b&gt;&#xa;pre-generated unique&#xa;8-char Base62 codes&#xa;batch leases" vertex="1">
