        <mxCell id="create-service" parent="arch-box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;strokeWidth=2;fontColor=#172B4D;fontSize=13;spacing=13;" value="&lt;b&gt;CREATE SERVICE POOL&lt;/b&gt;&#xa;validate URL&#xa;consume unique key&#xa;commit mapping&#xa;warm cache after commit" vertex="1">
