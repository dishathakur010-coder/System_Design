        <mxCell id="dns-cdn" parent="arch-box" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;strokeWidth=2;fontColor=#172B4D;fontSize=13;" value="&lt;b&gt;DNS + CDN&lt;/b&gt;&#xa;resolve healthy edge&#xa;cache hot 302 responses" vertex="1">
