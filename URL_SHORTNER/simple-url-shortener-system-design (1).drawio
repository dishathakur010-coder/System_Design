        <mxCell id="redis" parent="arch-box" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFF4E5;strokeColor=#FFAB00;strokeWidth=2;fontColor=#172B4D;fontSize=13;" value="&lt;b&gt;REDIS CLUSTER&lt;/b&gt;&#xa;code → long URL&#xa;TTL + jitter&#xa;replicas&#xa;short negative caching" vertex="1">
